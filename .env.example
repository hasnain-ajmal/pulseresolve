# Placeholders only. Never commit real values.
# The backend reads backend/.env (copy backend/.env.example). The frontend reads frontend/.env (copy frontend/.env.example).

# --- backend/.env ---
DATABASE_URL=sqlite:///./pulseresolve.db
SECRET_KEY=generate-a-long-random-string
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false
GEMINI_API_KEY=your-gemini-key-here          # several keys can be comma separated
GEMINI_MODEL=gemini-2.5-flash-lite,gemini-2.5-flash,gemini-3-flash-preview
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMS=768
AI_ENABLED=true
SEED_ADMIN_PASSWORD=change-me-lead           # test account 'lead'
SEED_AGENT_PASSWORD=change-me-agent          # test account 'agent'
SEED_DEMO_DATA=true

# --- frontend/.env ---
VITE_API_URL=http://localhost:8000/api
