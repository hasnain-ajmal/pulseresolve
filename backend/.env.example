# Copy to .env (never commit .env). Placeholder values only.
DATABASE_URL=sqlite:///./pulseresolve.db
SECRET_KEY=generate-with-python-c-import-secrets-print-secrets.token_hex-32
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false

GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMS=768
AI_ENABLED=true

# Test accounts created on first start (usernames: lead, agent). Test passwords only.
SEED_ADMIN_PASSWORD=change-me-lead
SEED_AGENT_PASSWORD=change-me-agent
SEED_DEMO_DATA=true
